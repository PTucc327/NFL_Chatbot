# NFL Pro-Bot — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# --- Gemini API (required) ---
# Powers all NLU: intent extraction and response formatting.
# Get a FREE key at https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, 1M tokens/day
GEMINI_API_KEY=your_gemini_api_key_here

# --- Repository URL (optional, recommended for production) ---
# Used to generate correct links to Terms of Service and Privacy Policy.
# Set to your GitHub repo root, no trailing slash.
# Example: https://github.com/your-username/nfl-pro-bot
# In Streamlit Community Cloud, add this under Settings → Secrets.
REPO_URL=


# --- App-wide Gemini budget (optional) ---
# Caps shared by ALL users, since everyone spends this one API key.
# Each question uses ~2 Gemini requests. 0 disables a cap.
# The free tier allows very few requests per day; enable billing on the key
# for a public deployment and size these caps to your budget.
GEMINI_MAX_MSGS_PER_MIN=5
GEMINI_MAX_MSGS_PER_DAY=200
