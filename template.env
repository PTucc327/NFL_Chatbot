# NFL Pro-Bot — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# --- Gemini API (required) ---
# Powers all NLU: intent extraction and response formatting.
# Get a FREE key at https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, 1M tokens/day
GEMINI_API_KEY=your_gemini_api_key_here

# --- Repository URL (optional, recommended for production) ---
# Used to generate correct links to Terms of Service and Privacy Policy.
# Set to your GitHub repo root, no trailing slash.
# Example: https://github.com/your-username/nfl-pro-bot
# In Streamlit Community Cloud, add this under Settings → Secrets.
REPO_URL=


# --- Gemini free tier (optional tuning) ---
# Models tried in order; each has its own free daily quota (per Google Cloud
# project, reset at midnight Pacific), so the app falls through to the next
# one when a model's quota runs out. Your exact per-model limits are at
# https://aistudio.google.com/rate-limit and are logged on every 429.
# Reading the question (small, structured) starts on the lite model; writing
# the answer starts on full Flash for quality. (GEMINI_MODELS sets both.)
GEMINI_EXTRACT_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_FORMAT_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Burst cap shared by ALL users (typed questions use 2 Gemini requests,
# sidebar buttons 1, repeated sidebar answers within 5 min 0). 0 = no cap.
GEMINI_MAX_MSGS_PER_MIN=10
# Optional daily cap on questions; 0 = rely on Google's free quotas.
GEMINI_MAX_MSGS_PER_DAY=0
# Per-request deadline in ms; a model slower than this is skipped for the
# next one in its chain. Google's minimum is 10000.
GEMINI_TIMEOUT_MS=20000

# --- Local favorites (optional, local single-user runs only) ---
# Saves favorite team/player to ~/.nfl_chatbot_prefs.json across restarts.
# Never enable on a hosted deployment: all visitors would share one file.
ENABLE_LOCAL_PREFS=0
